* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #000;
    color: white;
    min-height: 100vh;
}

.app {
    width: 100%;
    max-width: 900px;
    margin: auto;
    padding: 20px;
}

/* =========================
   HEADER
========================= */

header {
    text-align: center;
    padding: 20px 0 30px;
}

header h1 {
    color: white;
    font-size: 38px;
    letter-spacing: 2px;
}

header p {
    color: #d4af37;
    margin-top: 8px;
}

/* =========================
   GENERAL
========================= */

.hidden {
    display: none !important;
}

button {
    background: #d4af37;
    color: #000;
    border: none;
    border-radius: 10px;
    padding: 12px 18px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.2s ease;
}

button:hover {
    background: #f2d76b;
    transform: translateY(-2px);
}

/* GOLD BUTTON GLOW */

button:active {
    transform: scale(0.94);

    box-shadow:
        0 0 8px #d4af37,
        0 0 18px #d4af37,
        0 0 30px #d4af37;
}

/* =========================
   DECKS
========================= */

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
}

.section-title h2 {
    font-size: 25px;
}

.deck-list {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(230px, 1fr));
    gap: 15px;
}

.deck {
    background: #0d0d0d;
    border: 1px solid #333;
    border-radius: 18px;
    padding: 20px;
    transition: 0.2s;
}

.deck:hover {
    border-color: #d4af37;
    transform: translateY(-3px);
}

.deck h3 {
    margin-bottom: 8px;
}

.deck p {
    color: #999;
    margin-bottom: 15px;
}

.deck-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

/* =========================
   TOP BAR
========================= */

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 25px;
}

.deck-heading {
    text-align: center;
}

.deck-heading small {
    color: #aaa;
}

/* =========================
   FLASHCARD
========================= */

.flashcard-container {
    width: 100%;
    max-width: 680px;
    height: 390px;
    margin: auto;
    perspective: 1200px;
    cursor: pointer;
}

.flashcard {
    width: 100%;
    height: 100%;
    position: relative;

    transform-style: preserve-3d;

    transition:
        transform 0.7s ease;
}

.flashcard.flipped {
    transform: rotateY(180deg);
}

.card-face {
    position: absolute;

    width: 100%;
    height: 100%;

    background: #080808;

    border: 2px solid white;

    border-radius: 25px;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    padding: 40px;

    text-align: center;

    backface-visibility: hidden;

    transition: box-shadow 0.5s ease;
}

/* FRONT */

.card-front {
    box-shadow:
        0 0 10px
        rgba(255, 255, 255, 0.15);
}

/* WHITE GLOW WHEN FLIPPED */

.card-back {
    transform: rotateY(180deg);

    box-shadow:
        0 0 10px white,
        0 0 25px white,
        0 0 50px rgba(255, 255, 255, 0.7),
        0 0 90px rgba(255, 255, 255, 0.3);
}

.card-label {
    color: #d4af37;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 25px;
}

.card-face h2 {
    font-size: 29px;
    line-height: 1.45;
}

.flip-hint {
    color: #777;
    margin-top: 30px;
}

/* =========================
   STUDY CONTROLS
========================= */

.controls {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 25px;
}

.study-actions {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 15px;
}

/* =========================
   SPACED REPETITION
========================= */

.rating-section {
    text-align: center;
    margin-top: 25px;
}

.rating-section > p {
    color: #ccc;
    margin-bottom: 12px;
}

.rating-grid {
    display: grid;
    grid-template-columns:
        repeat(4, 1fr);

    gap: 10px;

    max-width: 650px;
    margin: auto;
}

.rating-grid button {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.rating-grid small {
    font-weight: normal;
    opacity: 0.7;
}

/* =========================
   QUIZ
========================= */

.quiz-box {
    width: 100%;
    max-width: 680px;
    margin: 30px auto;

    background: #0b0b0b;

    border: 1px solid #333;

    border-radius: 20px;

    padding: 40px;

    text-align: center;
}

.quiz-box h2 {
    margin: 25px 0;
    font-size: 27px;
    line-height: 1.4;
}

.quiz-options {
    display: grid;
    gap: 12px;
}

.quiz-options button {
    width: 100%;
    text-align: left;
}

#quizFeedback {
    margin: 20px 0;
    font-size: 18px;
    font-weight: bold;
}

/* =========================
   MODAL
========================= */

.modal {
    position: fixed;
    inset: 0;

    background:
        rgba(0, 0, 0, 0.9);

    display: flex;

    justify-content: center;
    align-items: center;

    padding: 20px;
}

.modal-content {
    width: 100%;
    max-width: 420px;

    background: #111;

    border: 1px solid #444;

    border-radius: 20px;

    padding: 30px;
}

.modal-content h2 {
    margin-bottom: 20px;
}

input {
    width: 100%;

    padding: 15px;

    border: none;

    border-radius: 10px;

    background: white;

    color: black;

    font-size: 16px;

    outline: none;
}

.modal-buttons {
    display: flex;

    gap: 10px;

    margin-top: 15px;
}

.modal-buttons button {
    flex: 1;
}

/* =========================
   MOBILE
========================= */

@media (max-width: 600px) {

    .app {
        padding: 15px;
    }

    header h1 {
        font-size: 30px;
    }

    .top-bar {
        flex-wrap: wrap;
    }

    .flashcard-container {
        height: 330px;
    }

    .card-face {
        padding: 25px;
    }

    .card-face h2 {
        font-size: 22px;
    }

    .rating-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .controls {
        gap: 7px;
    }

    .controls button {
        padding: 11px 10px;
        font-size: 13px;
    }

    .quiz-box {
        padding: 25px 18px;
    }
}